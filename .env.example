# SmartTeacher Environment Variables (optional — the app works fully offline without any of these)

# Supabase (client-side + optional cloud sync mode)
#   * Next.js build (PKCE flow): the OTP redirect must be
#     http://localhost:3000/auth/callback (and your production origin) in
#     Supabase → Authentication → URL Configuration → Redirect URLs.
#   * Magic links work in this order: user signs in on /auth → magic link →
#     hosted "Redirect to" URL → /auth/callback → exchange code → signed in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
